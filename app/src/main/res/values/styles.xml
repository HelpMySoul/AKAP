<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryVariant">@color/colorPrimaryDark</item>
        <item name="colorOnPrimary">@color/colorOnPrimary</item>
        <item name="colorSecondary">@color/colorSecondary</item>
        <item name="colorSecondaryVariant">@color/colorSecondaryDark</item>
        <item name="colorOnSecondary">@color/colorOnSecondary</item>

        <item name="android:textColor">@color/colorBlack</item>
        <item name="colorButtonNormal">@color/colorBlack</item>
        <item name="colorControlNormal">@color/colorBlack</item>
        <item name="colorControlActivated">@color/colorBlack</item>
        <item name="colorControlHighlight">@color/colorBlack</item>
    </style>    

    <style name="WhiteTheme" parent="AppTheme">
        <item name="colorPrimary">@color/whitePrimary</item>
        <item name="colorPrimaryVariant">@color/whitePrimaryDark</item>
        <item name="colorOnPrimary">@color/whitePrimaryLight</item>
    </style>

    <style name="BlueTheme" parent="AppTheme">
        <item name="colorPrimary">@color/bluePrimary</item>
        <item name="colorPrimaryVariant">@color/bluePrimaryDark</item>
        <item name="colorOnPrimary">@color/colorWhite</item>
    </style>

    <style name="RedTheme" parent="AppTheme">
        <item name="colorPrimary">@color/redPrimary</item>
        <item name="colorPrimaryVariant">@color/redPrimaryDark</item>
        <item name="colorOnPrimary">@color/colorWhite</item>

    </style>

    <style name="DarkTheme" parent="AppTheme">
        <item name="colorPrimary">@color/darkPrimary</item>
        <item name="colorPrimaryVariant">@color/darkPrimaryDark</item>
        <item name="colorOnPrimary">@color/darkBackground</item>

        <item name="android:textColor">@color/colorWhite</item>
        <item name="colorButtonNormal">@color/darkPrimary</item>
        <item name="colorControlNormal">@color/darkPrimary</item>
        <item name="colorControlActivated">@color/darkPrimary</item>
        <item name="colorControlHighlight">@color/darkPrimary</item>
        <item name="android:windowBackground">@color/darkBackground</item>

        <item name="materialButtonStyle">@style/DarkButtonStyle</item>
        <item name="checkboxStyle">@style/DarkCheckBoxStyle</item>
        <item name="editTextStyle">@style/DarkEditTextStyle</item>
        <item name="spinnerStyle">@style/DarkSpinnerStyle</item>
    </style>

    <style name="DarkButtonStyle" parent="Widget.MaterialComponents.Button">
        <item name="android:textColor">@color/colorWhite</item>
        <item name="backgroundTint">@color/darkPrimary</item>
    </style>

    <style name="DarkCheckBoxStyle" parent="Widget.MaterialComponents.CompoundButton.CheckBox">
        <item name="android:textColor">@color/colorWhite</item>
        <item name="android:buttonTint">@color/darkPrimary</item>
    </style>

    <style name="DarkEditTextStyle" parent="Widget.AppCompat.EditText">
        <item name="android:textColor">@color/colorWhite</item>
        <item name="android:textColorHint">@color/whitePrimary</item>
        <item name="colorControlNormal">@color/darkPrimary</item>
        <item name="colorControlActivated">@color/darkPrimary</item>
        <item name="colorControlHighlight">@color/darkPrimary</item>
    </style>

    <style name="DarkSpinnerStyle" parent="Widget.AppCompat.Spinner">
        <item name="android:popupBackground">@color/darkBackground</item>
        <item name="android:backgroundTint">?attr/colorPrimary</item>
    </style>

    <style name="AppButtonStyle" parent="ThemeOverlay.MaterialComponents">
        <item name="android:background">@drawable/button_border</item>
        <item name="android:textColor">@color/colorWhite</item>
        <item name="android:textSize">16sp</item>
        <item name="android:padding">8dp</item>
        <item name="android:layout_margin">8dp</item>
        <item name="android:gravity">center</item>
        <item name="cornerRadius">16dp</item>
    </style>

    <style name="AutoSizeButton" parent="Widget.MaterialComponents.Button">

        <item name="android:maxLines">1</item>
        <item name="android:lines">1</item>
        <item name="android:ellipsize">end</item>

        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>

    </style>

</resources>