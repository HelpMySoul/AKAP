<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/local_volume"
        android:layout_marginTop="16dp" />

    <SeekBar
        android:id="@+id/localVolumeSeekBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="100" />

    <CheckBox
        android:id="@+id/repeatCheckBox"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/repeat"
        android:layout_marginTop="8dp" />

    <CheckBox
        android:id="@+id/skipIntroCheckBox"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/skip_intro"
        android:layout_marginTop="8dp" />

    <CheckBox
        android:id="@+id/skipOutroCheckBox"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/skip_outro"
        android:layout_marginTop="8dp" />


    <Button
        android:id="@+id/shuffleSongButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/shuffleSongButton"
        android:textAlignment="center"
        android:orientation="vertical"   />

</LinearLayout>